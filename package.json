{
  "name": "campus-management-system",
  "version": "1.0.0",
  "description": "University Campus Management System - REST API backend (Node.js, Express, MongoDB, Mongoose, JWT, Socket.IO)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js --fresh",
    "socket:demo": "node scripts/socket-client.js",
    "test:api": "newman run postman/Campus-Management-System.postman_collection.json -e postman/local.postman_environment.json"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "socket.io",
    "campus"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  }
}
